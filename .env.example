# FINOVA Environment Variables
# Supabase project URL and anon public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: If these keys are not set or are invalid, FINOVA automatically switches to
# Local Demo Mode with rich sample financial data, allowing full testing offline.
